# Copy to .env (make up does this automatically). Docker and shared settings only.
COMPOSE_PROJECT_NAME=gd-business-site-lite-starter
APP_DOMAIN=gd-business-site-lite-starter.localhost

# Pins (source of truth: docs/VERSIONS.md; checked by `make versions`)
NODE_VERSION=24.22.3
NGINX_VERSION=1.30.6

# Ports (28xxx block). The dev server is internal to the node container; the preview (nginx) is published.
LITE_DEV_PORT=28310
LITE_PREVIEW_PORT=28390

LOCALE_DEFAULT=en
LOCALE_SUPPORTED=en

# Public origin of the site (canonical URLs, Open Graph, sitemap)
SITE_URL=http://gd-business-site-lite-starter.localhost:28390

# Read by the portal code (revalidate route, content source base URL)
PORTAL_REVALIDATE_SECRET=change-me
API_INTERNAL_URL=
