# Copy to .env (cp .env.example .env). Docker and shared settings only.
COMPOSE_PROJECT_NAME=gd-business-site-lite-starter
APP_DOMAIN=localhost

# Pins (source of truth: docs/VERSIONS.md)
NODE_VERSION=24.22.3
NGINX_VERSION=1.30.6
TRIVY_VERSION=0.76.2

# Ports (28xxx block), both bound to 127.0.0.1: Next dev server and the nginx preview of ./out.
LITE_DEV_PORT=28310
LITE_PREVIEW_PORT=28390

# Default locale is served at the root, a second one under /<code>/. One code (LOCALE_SUPPORTED=en) builds a one-language site with no second routes.
LOCALE_DEFAULT=en
LOCALE_SUPPORTED=en,bn

# Public origin of the site (canonical URLs, Open Graph, sitemap)
SITE_URL=http://127.0.0.1:28390

