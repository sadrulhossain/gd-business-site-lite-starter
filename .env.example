# Copy to .env (make up does this automatically). Docker and shared settings only.
COMPOSE_PROJECT_NAME=gd-business-site-lite-starter
APP_DOMAIN=localhost

# Pins (source of truth: docs/VERSIONS.md; checked by `make versions`)
NODE_VERSION=24.22.3
NGINX_VERSION=1.30.6

# Ports (28xxx block), both bound to 127.0.0.1: Next dev server and the nginx preview of ./out.
LITE_DEV_PORT=28310
LITE_PREVIEW_PORT=28390

# Default locale is served at the root, the other one under /<code>/. Exactly two codes are required (the second locale route tree needs one).
LOCALE_DEFAULT=en
LOCALE_SUPPORTED=en,bn

# Public origin of the site (canonical URLs, Open Graph, sitemap)
SITE_URL=http://127.0.0.1:28390

