# Rendered by the nginx image (envsubst) into /etc/nginx/conf.d/default.conf. Preview of the static export in ./out.
server_tokens off;

server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location = /healthz { access_log off; add_header Content-Type text/plain; return 200 "ok\n"; }

    # Clean URLs: /about -> about.html, /blog/ -> blog/index.html. Anything else is the exported 404 page.
    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }
    error_page 404 /404.html;
    location = /404.html { internal; }
}
