# Apache shared hosting (mod_dir, mod_deflate, mod_headers, mod_expires). Copied to out/.htaccess by the build.
# Upload the contents of out/ to the web root. Same policy as docker/nginx and public/_headers.

Options -Indexes
AddDefaultCharset UTF-8
AddType image/webp .webp

# Clean URLs: the export is /about/index.html, so /about redirects to /about/ (DirectorySlash) and /about/ serves the index.
DirectoryIndex index.html
DirectorySlash On

# Anything that does not exist is the exported 404 page.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  # Hashed build assets never change under the same name; image names carry the width, not a hash.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/images/#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
</IfModule>
